# Salin file ini menjadi .env.local lalu isi nilainya.

# Secret untuk menandatangani token JWT. Wajib diganti, minimal 32 karakter acak.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Folder tempat file video/audio disimpan (default: ./data/media)
MEDIA_DIR=

# Lokasi file database SQLite (default: ./data/mediaflow.db)
DB_PATH=

# Port server (default: 3000)
PORT=3000
