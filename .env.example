# Salin file ini menjadi .env.local lalu isi nilainya.

# Secret untuk menandatangani token JWT. Wajib diganti, minimal 32 karakter acak.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Folder tempat file video/audio disimpan (default: ./data/media)
MEDIA_DIR=

# Lokasi file database SQLite (default: ./data/mediaflow.db)
DB_PATH=

# Link tujuan tombol "Sewa" di landing page, mis. https://wa.me/6281234567890?text=Halo%20saya%20mau%20sewa
# Kosongkan = tombol Sewa menggulir ke bagian "Cara sewa".
SEWA_URL=

# Port server diatur di package.json (script dev/start memakai -p 3003).
# Nilai di file .env tidak dibaca Next.js untuk port, jadi baris ini hanya catatan.
PORT=3003
